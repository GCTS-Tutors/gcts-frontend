# Frontend production environment — copy to the project root as `.env.production`
# on the deploy host BEFORE `npm run build`. NEXT_PUBLIC_* values are inlined
# into the client bundle at build time, so they must be correct at build, not
# runtime. `.env.production` is gitignored — never commit real values.

# REQUIRED — the browser calls this. Must be HTTPS and a real domain (no raw IP,
# no localhost), or users' browsers will fail on mixed content / hit their own
# machine. config.ts composes `${BASE_URL}/${API_VERSION}`.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_VERSION=api/v1

# Optional integrations (leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Optional public site metadata
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
